{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: FastAPI",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "env":{
                "DEBUG_SQL": "true"
            },
            "args": [
                "app.core.main:app",
                "--reload"
            ],
            "jinja": true
        }
    ]
}
